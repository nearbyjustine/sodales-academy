# Copy to .env.local and fill in. Never commit .env.local.
#
# WARNING: this project has no separate development database. Whatever
# DATABASE_URL points at is what the live site serves, so a migration or a seed
# run locally takes effect in production immediately.

# Neon Postgres connection string (pooled).
DATABASE_URL=

# Where Neon Auth redirects back to. http://localhost:3000 locally, the
# deployed origin in production.
NEON_AUTH_BASE_URL=

# Secret used to sign the Neon Auth session cookie.
NEON_AUTH_COOKIE_SECRET=

# HMAC key for the short-lived invite-code cookie issued after a code is
# verified and before Google OAuth completes.
INVITE_CODE_SECRET=

# Promoted to role: admin by `pnpm db:seed`. Must match the Google account you
# sign in with, or you will have no way into /admin.
ADMIN_EMAIL=
